<?xml version="1.0" encoding="UTF-8"?>
<SliderSetInfo version="1">
    <SliderSet name="VanillaDigitigradeKhajiitThalmorBootsFemale">
        <ReferenceInfo ShapeName="FootPaws_Base"/>
        <DataFolder>VanillaDigitigradeKhajiitThalmorBootsFemale</DataFolder>
